FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

USER 0

# Install Node.js 22 from Nodesource + git, tar, ca-certificates
RUN microdnf install -y tar gzip ca-certificates shadow-utils && \
    curl -fsSL https://rpm.nodesource.com/setup_22.x | bash - && \
    microdnf install -y nodejs git && \
    microdnf clean all

# Copy and install bobshell CLI globally
COPY bobshell-2.0.4.tgz /tmp/
RUN npm install -g /tmp/bobshell-2.0.4.tgz && rm -f /tmp/bobshell-2.0.4.tgz

WORKDIR /opt/app-root/src

COPY package*.json tsconfig.json ./
RUN npm install

COPY src/ ./src/
RUN npm run build && npm prune --omit=dev

RUN mkdir -p /tmp/bob-workspace /opt/app-root/.bob && \
    chmod -R g=u /opt/app-root /tmp/bob-workspace /tmp

USER 1001

ENV PORT=8081 \
    BOB_WORKSPACE=/tmp/bob-workspace \
    NODE_ENV=production

EXPOSE 8081

CMD ["node", "dist/index.js"]
